# M4 eval set — one JSON object per line. Authored against the M1 corpus (Claude
# docs). Fields: id, question, expected_source_urls (doc pages that should answer
# it; page-level recall target), in_corpus (false = abstention test, expect "I
# don't know"). Only URLs + our own questions live here — no corpus body — so this
# is safe to version-control (decision ④). Lines starting with # are ignored.
{"id": "prompt-caching", "question": "How does prompt caching reduce cost, and what part of the request gets cached?", "expected_source_urls": ["https://platform.claude.com/docs/en/build-with-claude/prompt-caching"], "in_corpus": true}
{"id": "tool-use-works", "question": "How does tool use work with Claude from request to tool result?", "expected_source_urls": ["https://platform.claude.com/docs/en/agents-and-tools/tool-use/how-tool-use-works", "https://platform.claude.com/docs/en/agents-and-tools/tool-use/overview"], "in_corpus": true}
